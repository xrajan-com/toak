PORT=8080
HOST=0.0.0.0

# Comma-separated list. Use "*" only for local dev.
CORS_ORIGIN=https://tenofakind.com,https://www.tenofakind.com,https://ten-of-a-kind-poker.web.app,https://ten-of-a-kind-poker.firebaseapp.com

# Firebase Auth token verification
FIREBASE_PROJECT_ID=ten-of-a-kind-poker
# For local backend verification, set this to a Firebase service-account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Secure defaults. Enable either only for a short, controlled migration of
# trusted legacy data; never enable them for a normal production release.
ALLOW_LEGACY_CLIENT_ECONOMY_MIGRATION=false
ALLOW_LEGACY_UNCATALOGUED_ECONOMY_EVENTS=false
